{
  "mcpServers": {
    "seep": {
      "command": "python",
      "args": [
        "<SEEP_ROOT>\\Tool\\mcp\\seep_mcp_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "transport": "stdio"
    },
    "ida": {
      "command": "<IDA_PYTHON>",
      "args": [
        "<IDA_ROOT>\\Lib\\site-packages\\ida_pro_mcp\\server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "transport": "stdio",
      "lifecycle": "eager",
      "requestTimeoutMs": 180000
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "<YOUR_PLAYWRIGHT_TOKEN>"
      },
      "transport": "stdio",
      "lifecycle": "eager"
    },
    "js-reverse": {
      "command": "npx",
      "args": [
        "-y",
        "js-reverse-mcp"
      ],
      "transport": "stdio",
      "lifecycle": "lazy"
    }
  },
  "_comment_optional": "reverselab 自带 3 个 MCP（可选注册）：ReverseLabToolsMCP / JSHookLocal / GhidraMCP，源码见 share/mcp/Tool/reverselab/tools/skills/mcp/",
  "_comment_downloads": "各 MCP 依赖的工具来源见 share/docs/DOWNLOADS.md"
}