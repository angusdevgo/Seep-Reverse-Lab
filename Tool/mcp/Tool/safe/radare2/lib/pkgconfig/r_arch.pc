prefix=D:/a/radare2/radare2/radare2-5.9.8-w64
libdir=${prefix}/lib
includedir=${prefix}/include

Name: r_arch
Description: radare foundation libraries
Version: 5.9.8
Requires: r_util, r_esil, r_crypto, r_reg
Libs: -L${libdir} -lr_arch
Libs.private: -lws2_32 -lwininet -lpsapi
Cflags: -I${includedir}/libr
