# build artifacts
*.class
*.jar
!skills/apk-reverse/scripts/dexpatch/*.java

# working data -- never commit samples or outputs
*.apk
*.aab
*.dex
*.odex
*.vdex
*.oat
*.so
*.jks
*.keystore
*.pk8
