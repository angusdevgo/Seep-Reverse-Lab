{
  "mcpServers": {
    "seep": {
      "command": "python",
      "args": ["Tool/mcp/seep_mcp_server.py"],
      "env": { "PYTHONIOENCODING": "utf-8" },
      "transport": "stdio"
    },
    "js-reverse": {
      "command": "npx",
      "args": ["-y", "js-reverse-mcp"],
      "transport": "stdio"
    }
  }
}
